# Copy to .env and fill in what you need. Every setting is optional: with nothing configured the
# app runs fully offline on the bundled dataset and the copilot uses its rule-based analyst.

# --- Live market data (only used in "Live" data mode; local mode never touches the network) ---
ALPHA_VANTAGE_API_KEY=

# --- AI copilot providers (tried in order; any failure falls through to the next) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
AI_PROVIDER_PRIMARY=gemini
AI_PROVIDER_FALLBACK=groq

# --- API hardening (set these before exposing the API beyond localhost) ---
# Require `Authorization: Bearer <token>` on every /api route except /api/health.
VALUENGINE_API_TOKEN=
# Comma-separated browser origins allowed to call the API.
VALUENGINE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VALUENGINE_LOG_LEVEL=INFO
# Build the factor model and universe radar in the background at startup (1/0).
VALUENGINE_WARMUP=1

# --- Frontend (Vite) ---
# If VALUENGINE_API_TOKEN is set, the frontend must send the same token.
VITE_API_TOKEN=
